# Copiez ce fichier vers `app/.env` et renseignez votre clé.
#
#   cp .env.example app/.env
#
# La simple présence de API_FOOTBALL_KEY fait basculer le site du mode
# démonstration vers les données réelles.

# Clé API-Football (https://dashboard.api-football.io)
API_FOOTBALL_KEY=

# Hôte de l'API. Laissez tel quel sauf si vous utilisez le miroir RapidAPI.
# API_FOOTBALL_HOST=v3.football.api-sports.io

# Saison interrogée.
# ⚠️ Le plan GRATUIT ne donne accès qu'aux saisons 2022, 2023 et 2024.
#    Demander la saison en cours renvoie :
#    {'plan': 'Free plans do not have access to this season, try from 2022 to 2024.'}
#
# Laissez 2023 avec un plan gratuit : les données sont réelles mais la saison
# étant terminée, il n'y a aucun match à venir. Le site évalue alors le modèle
# sur des résultats connus (/api/results et /api/backtest).
#
# Avec un plan payant, mettez cette ligne en commentaire pour utiliser
# automatiquement la saison courante.
API_FOOTBALL_SEASON=2023

# Intervalle de synchronisation, en minutes.
# Avec le plan gratuit (~100 requêtes/jour) et une seule ligue, ne descendez
# pas sous 120.
PRONOLAB_SYNC_MINUTES=60

# Fenêtre de récupération des matchs à venir, en jours.
PRONOLAB_DAYS_AHEAD=7

# Nombre de matchs récents utilisés pour la forme d'une équipe.
PRONOLAB_FORM_WINDOW=6

# Lissage bayésien des forces d'équipes. Plus c'est haut, plus les forces sont
# ramenées vers la moyenne de la ligue. /api/backtest mesure l'effet réel.
PRONOLAB_PRIOR_WEIGHT=1.0

# Emplacement de la base SQLite (par défaut : prono.db à la racine du projet).
# PRONOLAB_DB=/chemin/vers/prono.db

# Force le mode de données. Inutile en général : la présence de la clé suffit.
# PRONOLAB_MODE=demo
