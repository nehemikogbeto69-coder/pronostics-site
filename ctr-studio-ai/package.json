{
  "name": "ctr-studio-ai",
  "version": "1.0.0",
  "private": true,
  "description": "CTR Studio AI — éditeur de miniatures YouTube, analyse heuristique et générateur d'idées. 100 % local, sans API payante.",
  "type": "module",
  "scripts": {
    "start": "node tools/dev-server.mjs",
    "dev": "node tools/dev-server.mjs",
    "serve": "node tools/dev-server.mjs --host 0.0.0.0 --port 5173",
    "test": "node --test tests/*.test.mjs",
    "test:core": "node --test tests/png.test.mjs tests/composition.test.mjs tests/textLayout.test.mjs tests/renderer.test.mjs tests/export.test.mjs",
    "test:features": "node --test tests/analysis.test.mjs tests/ideas.test.mjs",
    "test:ui": "node --test tests/ui.test.mjs tests/modules.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "jsdom": "^30.1.3"
  },
  "keywords": [
    "youtube",
    "thumbnail",
    "miniature",
    "canvas",
    "png",
    "editor",
    "analyse",
    "heuristique",
    "vanilla-js",
    "offline"
  ],
  "license": "MIT"
}
